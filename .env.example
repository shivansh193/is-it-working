# YouCam API key from the YouCam API console. Server-side only — never prefix with NEXT_PUBLIC_.
YOUCAM_API_KEY=
# Optional overrides (defaults shown)
# YOUCAM_API_HOST=https://yce-api-01.makeupar.com
# YOUCAM_FILE_PATH=/s2s/v2.0/file
# YOUCAM_TASK_PATH=/s2s/v2.1/task/skin-analysis
# 1 = fake scores, no API calls, no units spent (also the default when no key is set)
YOUCAM_MOCK=
# 1 = save every finished task response to fixtures/real/ (git-ignored). Local dev only.
SAVE_FIXTURES=
# Secret for signing mask-proxy URLs (defaults to the API key)
MASK_SIGNING_SECRET=
# Units on the account at the start, for the dev-only budget badge
NEXT_PUBLIC_UNIT_START=1000
